# Server
PORT=5000
NODE_ENV=development

# On every start the server runs migrations, creates the admin (below) if none
# exists, and seeds demo catalog data on a brand-new DB. Set false to skip.
AUTO_MIGRATE=true

# PostgreSQL — either DATABASE_URL (hosted, e.g. Neon; keep ?sslmode=require)
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# ...or the individual DB_* settings for local Postgres:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=medpet_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d

# Default admin account — auto-created on server startup if no admin exists
ADMIN_NAME=MedPet Admin
ADMIN_EMAIL=admin@medpet.com
ADMIN_PASSWORD=admin123

# CORS — allowed admin-panel origin(s), comma-separated, or * for any
CLIENT_URL=http://localhost:5173

# ─── Transactional email (Gmail SMTP + App Password) ────────────────────────
# MAIL_PASSWORD must be a Google *App Password* (Google Account → Security →
# 2-Step Verification → App passwords), NOT your normal Gmail password.
# When these are unset the API still runs — emails are logged instead of sent.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=your_16_char_app_password
MAIL_FROM_EMAIL=you@gmail.com
MAIL_FROM_NAME=medPet

# Public base URL used to build password-reset / delivery-partner invite links.
PUBLIC_APP_URL=http://localhost:5000

# ─── Real-time delivery tracking ────────────────────────────────────────────
# Free routing / geocoding endpoints (no API key). Override only to self-host.
OSRM_URL=https://router.project-osrm.org
NOMINATIM_URL=https://nominatim.openstreetmap.org
GEO_USER_AGENT=MedPet-Delivery/1.0 (Amravati)

# Built-in demo: walk a fake driver along a real OSRM route emitting live socket
# events. Set to true to try the customer app / admin Live Map without a real rider.
SIMULATION_MODE=false
SIM_PINGS=50
SIM_INTERVAL_MS=3000
SIM_PASSWORD=sim12345
